# Production build. Separate from Dockerfile.frontend.dev, which relies on
# bind-mounted src/ and hot-reload -- not applicable to a real image.
#
# Vite's `vite build` (no --mode flag in package.json's build script)
# always loads plain `.env` regardless of mode; it does NOT recognize
# non-standard names like `.env.test`/`.env.prod`. ENV_FILE selects which
# one gets copied to `.env` before the build, so the right API base URL
# and Firebase/AWS config get baked into the JS bundle -- this app has no
# runtime config, so each environment needs its own image build (unlike
# the backend services, which promote one build across environments).
FROM node:22-alpine AS builder
WORKDIR /app

COPY package.json yarn.lock ./
RUN corepack enable && yarn install --frozen-lockfile --ignore-scripts

COPY . .

ARG ENV_FILE=.env.test
RUN test -f "${ENV_FILE}" || (echo "Missing ${ENV_FILE}" && exit 1)
RUN cp "${ENV_FILE}" .env

RUN NODE_OPTIONS=--max-old-space-size=4096 yarn build

# nginx-unprivileged, not the Dockerfile.frontend.dev node base -- this
# stage never runs node, just serves the static build/ output. Unprivileged
# variant (not plain nginx:alpine) because it runs as non-root on port 8080
# out of the box, matching the same runAsNonRoot + readOnlyRootFilesystem
# securityContext every backend service in the chart already uses -- plain
# nginx:alpine needs root to bind :80 and write /var/cache/nginx et al.
FROM nginxinc/nginx-unprivileged:alpine AS runner
COPY --from=builder /app/build /usr/share/nginx/html
COPY nginx.frontend.conf /etc/nginx/conf.d/default.conf

EXPOSE 8080
